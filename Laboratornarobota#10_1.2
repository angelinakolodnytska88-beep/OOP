using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Laboratornarobota_10_1_2
{
    interface ITask
    {
        void Start();
        void Complete();
        string GetTaskInfo();
    }

    class WorkTask : ITask
    {
        private string taskName;
        private bool isCompleted;

        public WorkTask(string name)
        {
            taskName = name;
            isCompleted = false;
        }

        public void Start()
        {
            Console.WriteLine($"Task '{taskName}' has started.");
        }

        public void Complete()
        {
            isCompleted = true;
            Console.WriteLine($"Task '{taskName}' has been completed.");
        }

        public string GetTaskInfo()
        {
            return $"Task Name: {taskName}, Completed: {isCompleted}";
        }
    }

